# Optional local environment for BLI runs. Copy to .env or export these in
# the shell. .env is ignored by git so tokens and local paths stay private.

HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=${HF_TOKEN}

BLI_ROOT=/scratch/$USER/bli
NANOTRON_ROOT=/scratch/$USER/pretrain/nanotron
NANOTRON_ENV=$HOME/nanotron-env
HF_HOME=/scratch/$USER/cache/hf_cache

# External benchmark checkout; not tracked in this repository.
WORLDVALUESBENCH_ROOT=$BLI_ROOT/external/WorldValuesBench

# Keep disabled for anonymous/review runs. Set to 1 for private experiment logs.
BLI_ENABLE_WANDB=0
